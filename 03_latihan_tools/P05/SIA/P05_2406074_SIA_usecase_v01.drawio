<mxfile host="65bd71144e">
    <diagram id="4f7d70a5478c4c98b9c0afb16ee631c5" name="UC01">
        <mxGraphModel dx="1797" dy="1033" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;border:1px solid #000;font-family:Arial,sans-serif;font-size:13px;color:#000&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;SIA-UC01 Lihat Jadwal Kuliah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Melihat jadwal kuliah yang tersedia.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mahasiswa meminta jadwal; sistem menampilkan jadwal kuliah yang tersedia.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Prasyarat&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mahasiswa terautentikasi; informasi jadwal tersedia di sistem.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;1. Memilih Lihat Jadwal Kuliah&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;1. Sistem mencari jadwal kuliah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;2. ?&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;2. Sistem menampilkan jadwal kuliah yang tersedia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;5. Jadwal belum tersedia (cabang dari alur normal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;6. Sistem menyampaikan bahwa jadwal belum tersedia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Jadwal ditampilkan; tidak ada perubahan data.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="1000" width="750" x="50" y="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="2c96f439b83e4ff7ae9a8defabb8ea78" name="UC02">
        <mxGraphModel dx="1797" dy="1033" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;border:1px solid #000;font-family:Arial,sans-serif;font-size:13px;color:#000&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;SIA-UC02 Kelola Jadwal Kuliah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Admin Akademik&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mengelola dan memperbarui informasi jadwal kuliah.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Admin memilih jadwal untuk dikelola; sistem menampilkan informasi; Admin mengirim perubahan; sistem memvalidasi dan menyimpan hasil.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Prasyarat&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Admin Akademik terautentikasi dan memiliki hak akses.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;1. Memilih jadwal yang akan dikelola&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;2. Menampilkan informasi jadwal terpilih&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;3. Mengirim perubahan jadwal&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;4. Memvalidasi, menyimpan perubahan dan menampilkan hasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;5. Data jadwal tidak dapat diproses (cabang dari alur normal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;6. Menolak penyimpanan dan menyampaikan alasan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Perubahan jadwal tersimpan; jika gagal, data jadwal tidak berubah.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="1000" width="750" x="50" y="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="4f7f96846b464050800e467f3c817b81" name="UC03">
        <mxGraphModel dx="1797" dy="1033" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;border:1px solid #000;font-family:Arial,sans-serif;font-size:13px;color:#000&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;SIA-UC03 Ajukan KRS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Menyimpan pengajuan KRS yang lolos validasi untuk menunggu keputusan Dosen Wali.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mahasiswa memilih mata kuliah dan mengirim pengajuan; sistem menjalankan UC04; bila valid sistem menyimpan KRS berstatus Menunggu persetujuan Dosen Wali dan menampilkan konfirmasi.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Prasyarat&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mahasiswa terautentikasi; data mata kuliah, prasyarat, dan jadwal tersedia.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;1. Memilih mata kuliah dan mengirim pengajuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;2. Memeriksa validasi melalui SIA-UC04&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;3. ?&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;4. Menyimpan KRS berstatus Menunggu persetujuan Dosen Wali&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;5. Melihat konfirmasi pengajuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;6. Menampilkan konfirmasi dan menyediakan bukti pengajuan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;7. Memilih unduh bila diinginkan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;8. Menjalankan SIA-UC05 hanya jika kondisi extend terpenuhi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;9. Pengajuan tidak memenuhi validasi pada langkah 2; atau Mahasiswa tidak memilih unduh pada langkah 7 (cabang dari alur normal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;10. Menampilkan alasan dan tidak menyimpan pengajuan; jika tidak memilih unduh, UC05 tidak dijalankan dan pengajuan tetap berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;KRS tersimpan berstatus Menunggu persetujuan Dosen Wali; jika validasi gagal tidak ada pengajuan baru yang berhasil tersimpan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="1000" width="750" x="50" y="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="596ec153423f48278a9fe30f2fe0f613" name="UC04">
        <mxGraphModel dx="1797" dy="1033" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;border:1px solid #000;font-family:Arial,sans-serif;font-size:13px;color:#000&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;SIA-UC04 Validasi KRS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Sistem (di-include oleh SIA-UC03)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Menentukan apakah pengajuan KRS memenuhi pemeriksaan yang ditetapkan.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Sistem memeriksa kelengkapan data, prasyarat mata kuliah, dan benturan jadwal; hasil valid atau alasan kegagalan dikembalikan kepada UC03.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Prasyarat&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Data pengajuan telah dikirim melalui UC03 dan tersedia untuk diperiksa.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;1. Menerima data pengajuan dari UC03&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;2. Memeriksa kelengkapan, prasyarat, dan benturan jadwal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;3. ?&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;4. Mengembalikan hasil validasi ke UC03&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;5. Satu atau lebih pemeriksaan gagal (cabang dari alur normal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;6. Mengembalikan alasan kegagalan ke UC03; pengajuan tidak dinyatakan berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Hasil validasi diberikan ke UC03; UC04 tidak menyimpan pengajuan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="1000" width="750" x="50" y="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="de326c119cdf46989d4c84f4a3d159fc" name="UC05">
        <mxGraphModel dx="1797" dy="1033" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;border:1px solid #000;font-family:Arial,sans-serif;font-size:13px;color:#000&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;SIA-UC05 Unduh Bukti Pengajuan KRS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Memperoleh bukti dari pengajuan KRS yang telah tersimpan.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mahasiswa memilih Unduh Bukti Pengajuan KRS pada konfirmasi; sistem menyediakan bukti dari KRS tersimpan.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Prasyarat&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;UC03 berhasil dan bukti pengajuan tersedia. Relasi extend UC03 pada extension point bukti tersedia, dengan kondisi [Mahasiswa memilih unduh].&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;1. Memilih Unduh Bukti Pengajuan KRS pada konfirmasi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;2. Menyediakan bukti dari pengajuan KRS yang tersimpan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;3. Mahasiswa tidak memilih unduh pada extension point UC03 (cabang dari alur normal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;4. UC05 tidak dijalankan; pengajuan UC03 tetap berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Bukti disediakan untuk diunduh; data KRS tidak berubah.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="1000" width="750" x="50" y="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="59ebad6f65d54216b08b489e6eb43f97" name="UC06">
        <mxGraphModel dx="1797" dy="1033" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;border:1px solid #000;font-family:Arial,sans-serif;font-size:13px;color:#000&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;SIA-UC06 Proses Keputusan KRS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Dosen Wali&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mencatat persetujuan atau penolakan atas KRS yang menunggu keputusan.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Dosen Wali memilih pengajuan; sistem menampilkan rincian; Dosen Wali memilih Setujui atau Tolak dan memasukkan catatan; sistem menyimpan keputusan dan menampilkan hasil.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Prasyarat&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Pengajuan KRS tersimpan dan berstatus menunggu keputusan; Dosen Wali terautentikasi dan berhak memprosesnya.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;1. Memilih pengajuan KRS&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;2. Menampilkan rincian KRS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;3. Memilih Setujui atau Tolak&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;5. Menyimpan keputusan dan catatan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;4. Memasukkan catatan keputusan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;7. Menampilkan hasil keputusan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;9. Pengajuan tidak lagi berstatus menunggu keputusan (cabang dari alur normal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;10. Menampilkan status terkini dan tidak menimpa keputusan yang telah ada&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Status keputusan dan catatan tercatat; bila gagal, tidak ada keputusan baru yang tersimpan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="1000" width="750" x="50" y="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="7c28ed921c70410090815e08d0f163ab" name="UC07">
        <mxGraphModel dx="1797" dy="1033" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;border:1px solid #000;font-family:Arial,sans-serif;font-size:13px;color:#000&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;SIA-UC07 Lihat Kalender Akademik&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Civitas Akademika (Mahasiswa dan Dosen mewarisi akses)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Melihat agenda resmi akademik institusi.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Aktor meminta kalender akademik; sistem menampilkan agenda yang tersedia.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Prasyarat&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Aktor terautentikasi; informasi kalender tersedia.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;1. Memilih Lihat Kalender Akademik&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;2. Mengambil dan menampilkan kalender akademik&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;3. Kalender belum tersedia (cabang dari alur normal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;4. Menampilkan informasi kalender belum tersedia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Kalender ditampilkan bila tersedia; jika belum, sistem menyampaikan kondisinya.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="1000" width="750" x="50" y="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="b8412bc47ba143b5b573dd7746c03b66" name="UC08">
        <mxGraphModel dx="1797" dy="1033" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;border:1px solid #000;font-family:Arial,sans-serif;font-size:13px;color:#000&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;SIA-UC08 Input Nilai Mata Kuliah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Dosen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mencatat nilai mahasiswa pada mata kuliah yang diampu setelah masa perkuliahan berakhir.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Dosen memilih mata kuliah dan mahasiswa, memasukkan nilai; sistem memeriksa rentang sah, menyimpan nilai, memeriksa kelengkapan, lalu Admin Akademik mengesahkan nilai lengkap. Sistem menyiapkan publikasi, menerbitkan KHS di portal, dan memberitahu mahasiswa.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Prasyarat&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Dosen terautentikasi, merupakan pengampu mata kuliah terpilih, dan masa perkuliahan berakhir.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;1. Memilih mata kuliah dan mahasiswa, memasukkan lalu mengirim nilai&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;2. Menampilkan daftar/formulir, memeriksa rentang, lalu menyimpan nilai sah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;3. Nilai di luar rentang; atau nilai belum lengkap saat pemeriksaan kelengkapan (cabang dari alur normal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;4. Menolak nilai di luar rentang; meminta dosen melengkapi nilai yang kurang lalu melanjutkan sebelum pengesahan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Nilai sah dan lengkap tersimpan, disahkan, dipublikasikan dan diberitahukan; nilai tak sah ditolak. Nilai yang belum lengkap dilengkapi sebelum pengesahan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="1000" width="750" x="50" y="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="53c5f8bca5514a92b8ea89e9e75c5733" name="UC09">
        <mxGraphModel dx="1797" dy="1033" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;border:1px solid #000;font-family:Arial,sans-serif;font-size:13px;color:#000&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;SIA-UC09 Lihat KHS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Melihat Kartu Hasil Studi untuk semester yang dipilih dengan nilai yang sudah dipublikasikan.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mahasiswa memilih semester; sistem mencari dan menampilkan KHS yang berisi nilai terpublikasi.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Prasyarat&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mahasiswa terautentikasi; data nilai mungkin tersedia untuk semester terpilih.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;1. Memilih semester dan melihat KHS&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;2. Mencari lalu menampilkan KHS dengan nilai yang telah dipublikasikan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;3. Belum ada nilai yang dipublikasikan untuk semester tersebut (cabang dari alur normal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;4. Menyampaikan bahwa KHS belum tersedia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;KHS semester terpilih ditampilkan jika tersedia; bila belum, sistem menyampaikan KHS belum tersedia.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="1000" width="750" x="50" y="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="5e7f598dc04641b59173ea20f86e3cd2" name="UC10">
        <mxGraphModel dx="1797" dy="1033" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;border:1px solid #000;font-family:Arial,sans-serif;font-size:13px;color:#000&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;SIA-UC10 Kelola Data Mahasiswa (use case umum)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Admin Akademik&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Mengelola data mahasiswa melalui operasi tambah, ubah, atau hapus.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Admin memilih operasi dan data; sistem menampilkan form/data, memvalidasi operasi, menyimpan perubahan valid, dan mengonfirmasi hasil. UC11–UC13 merupakan spesialisasi UC10.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Prasyarat&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Admin Akademik terautentikasi dan memiliki hak akses pengelolaan data mahasiswa.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold;width:28%&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;1. Memilih operasi; memasukkan atau memilih data; mengonfirmasi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;2. Menampilkan form/data, memvalidasi, menyimpan perubahan dan menampilkan hasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;3. Data atau operasi tidak valid (cabang dari alur normal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;4. Menolak perubahan dan menampilkan alasan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:7px;font-weight:bold&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:7px&quot;&gt;Perubahan tersimpan dan dikonfirmasi atau ditolak tanpa perubahan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="1000" width="750" x="50" y="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
