    <diagram id="4Kq7h99CXrMrywCGVLvN" name="UC02">
        <mxGraphModel dx="806" dy="-120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="D9OPM0A1-GMtmTAGerxG-0"/>
                <mxCell id="D9OPM0A1-GMtmTAGerxG-1" parent="D9OPM0A1-GMtmTAGerxG-0"/>
                <mxCell id="wEpCu9X5oknM5DWmaTKy-0" parent="D9OPM0A1-GMtmTAGerxG-1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse: collapse; width: 100%; border: 1px solid #000000; font-family: Arial, sans-serif; font-size: 13px; color: #000000;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top; width: 30%;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;LAB-UC02 Kelola Data Peralatan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Petugas Laboratorium&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Data peralatan terkelola melalui satu fungsi pengelolaan bersama&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Petugas membuka fungsi pengelolaan data peralatan, memilih bentuk pengelolaan, dan menyimpan perubahan. Bentuk tambah, ubah, dan hapus dijabarkan pada tabel khususnya masing-masing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;1. Petugas membuka fungsi Kelola Data Peralatan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;2. Sistem menampilkan daftar data peralatan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;3. Petugas memilih bentuk pengelolaan, yaitu tambah, ubah, atau hapus&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;4. Sistem menampilkan formulir sesuai bentuk pengelolaan yang dipilih&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;5. Petugas mengisi atau mengonfirmasi data&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;6. Sistem memeriksa kelengkapan dan keabsahan data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;7. Petugas menyimpan perubahan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;8. Sistem menyimpan perubahan dan menampilkan konfirmasi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;9. Data tidak lengkap atau tidak sah (cabang dari langkah 6)&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;10. Sistem menolak penyimpanan dan menampilkan pesan kesalahan data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Use case selesai jika perubahan data peralatan tersimpan; jika data tidak lengkap atau tidak sah, perubahan tidak tersimpan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="580" width="750" x="1200" y="1280" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
