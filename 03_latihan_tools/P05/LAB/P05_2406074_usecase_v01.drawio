                <mxCell id="CFE2_qUXir79ocX9CMHF-0" parent="GaaGj7jphOHF6YVVJkEK-1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse: collapse; width: 100%; border: 1px solid #000000; font-family: Arial, sans-serif; font-size: 13px; color: #000000;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top; width: 30%;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;LAB-UC10 Hapus Data Peralatan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Petugas Laboratorium&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Data peralatan terhapus sebagai bentuk khusus dari pengelolaan data peralatan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Petugas memilih data peralatan, mengonfirmasi penghapusan, dan sistem menghapus data tersebut; langkah bersama mengikuti Tabel skenario LAB-UC02&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;1. Petugas memilih data peralatan yang akan dihapus&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;2. Sistem memeriksa peralatan tidak sedang dipinjam dan tidak memiliki pengajuan aktif&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;3. Petugas mengonfirmasi penghapusan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;4. Sistem menghapus data peralatan dan menampilkan konfirmasi penghapusan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;5. Peralatan sedang dipinjam atau memiliki pengajuan aktif (cabang dari langkah 2)&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;6. Sistem menolak penghapusan dan menampilkan pesan peralatan masih terpakai&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Use case selesai jika data peralatan terhapus; jika peralatan sedang dipinjam atau memiliki pengajuan aktif, data tidak terhapus.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="500" width="750" x="490" y="570" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="Ih_Dwjoa2gWaUoYfIq8x" name="Page-11">
        <mxGraphModel dx="1739" dy="1029" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="FC40kfh7IE3KcxNj4C9H-0"/>
                <mxCell id="FC40kfh7IE3KcxNj4C9H-1" parent="FC40kfh7IE3KcxNj4C9H-0"/>
                <mxCell id="OuY-GrYM5zCkZ992US1E-0" parent="FC40kfh7IE3KcxNj4C9H-1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse: collapse; width: 100%; border: 1px solid #000000; font-family: Arial, sans-serif; font-size: 13px; color: #000000;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top; width: 30%;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;LAB-UC11 Catat Pengembalian Peralatan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Petugas Laboratorium&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Pengembalian tercatat dan status peminjaman serta kondisi peralatan terbaru&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Petugas memilih peminjaman yang akan dikembalikan, mengonfirmasi alat yang kembali, dan menyimpan pencatatan. Prasyarat: peminjaman berstatus Dipinjam&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;1. Petugas memilih peminjaman yang akan dikembalikan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;2. Sistem menampilkan data peminjaman terpilih dan statusnya&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;3. Petugas mengonfirmasi alat yang kembali dan jumlahnya&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;4. Sistem menampung konfirmasi petugas&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;5. Sistem memeriksa status peminjaman harus Dipinjam&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;6. Sistem menjalankan Periksa Kondisi Peralatan (lihat Tabel skenario LAB-UC12)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;7. Petugas menyimpan pencatatan pengembalian&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;8. Sistem menyimpan tanggal kembali dan kondisi serta mengubah status peminjaman menjadi Selesai&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;9. Petugas melihat konfirmasi&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;10. Sistem menampilkan ringkasan pengembalian&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;11. Status bukan Dipinjam (cabang dari langkah 5)&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;12. Sistem menolak pencatatan dan menampilkan status peminjaman saat ini&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;13. Kondisi Rusak Ringan atau Rusak Berat dicatat pada langkah 6 (cabang dari langkah 6)&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;14. Sistem tetap menyimpan pencatatan, menandai kondisi tersebut pada data peralatan, dan pengembalian tetap tercatat tanpa denda&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;15. Jumlah alat yang kembali tidak sesuai (cabang dari langkah 3)&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;16. Sistem meminta petugas memeriksa kembali isian sebelum penyimpanan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Use case selesai jika pengembalian tercatat dengan tanggal kembali dan kondisi peralatan serta status peminjaman menjadi Selesai; jika status bukan Dipinjam, tidak ada pengembalian baru yang tercatat dan status peminjaman tidak berubah.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="700" width="750" x="370" y="1070" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="DkcSpIYVBTCpgrnCD2by" name="Page-12">
        <mxGraphModel dx="1159" dy="686" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="zh-dx-rdOLSIUH5Z8JbV-0"/>
                <mxCell id="zh-dx-rdOLSIUH5Z8JbV-1" parent="zh-dx-rdOLSIUH5Z8JbV-0"/>
                <mxCell id="8cD3T1eevOFenrW38Npo-0" parent="zh-dx-rdOLSIUH5Z8JbV-1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse: collapse; width: 100%; border: 1px solid #000000; font-family: Arial, sans-serif; font-size: 13px; color: #000000;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top; width: 30%;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;LAB-UC12 Periksa Kondisi Peralatan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Petugas Laboratorium (berjalan di dalam LAB-UC11 Catat Pengembalian Peralatan)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Kondisi peralatan yang dikembalikan terperiksa dan tercatat&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Sistem memeriksa kondisi peralatan yang dikembalikan dan mencatat nilainya sebagai bagian dari pencatatan pengembalian. Use case ini berjalan di dalam UC11 dan tidak mempunyai interaksi langsung dengan aktor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;1. Alur pengembalian memanggil Periksa Kondisi Peralatan dengan peralatan yang dikembalikan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;2. Sistem menampilkan pilihan kondisi, yaitu Baik, Rusak Ringan, atau Rusak Berat&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;3. Petugas memilih nilai kondisi peralatan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;4. Sistem mencatat nilai kondisi pada data pengembalian&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;5. Petugas belum memilih nilai kondisi (cabang dari langkah 4)&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;6. Sistem meminta petugas memilih nilai kondisi sebelum pencatatan disimpan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Use case selesai jika nilai kondisi peralatan tercatat pada data pengembalian; jika nilai belum dipilih, pencatatan tidak disimpan sampai nilai dipilih.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="520" width="750" x="550" y="470" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
