                <mxCell id="nE710Gj88y0RXVAVD4fJ-0" parent="qvaoJIxWv4j-De76baeC-1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" value="&lt;table style=&quot;border-collapse: collapse; width: 100%; border: 1px solid #000000; font-family: Arial, sans-serif; font-size: 13px; color: #000000;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top; width: 30%;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;LAB-UC03 Ajukan Peminjaman&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Peminjam (berlaku untuk Mahasiswa dan Dosen)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Pengajuan peminjaman tercatat dan dapat diproses oleh petugas&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Peminjam memilih peralatan yang tersedia, mengisi data peminjaman, dan mengirim pengajuan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Kegiatan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Respon sistem&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;1. Peminjam memilih peralatan yang akan dipinjam&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;2. Sistem menjalankan Periksa Ketersediaan (lihat Tabel skenario LAB-UC04)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;3. Peminjam mengisi tanggal pinjam, tanggal rencana kembali, dan keperluan peminjaman&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;4. Sistem memeriksa kelengkapan isian dan menampilkan ringkasan pengajuan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;5. Peminjam mengirim pengajuan&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;6. Sistem menyimpan pengajuan dengan status Menunggu Keputusan dan menampilkan nomor pengajuan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Alternative&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;7. Peralatan yang dipilih tidak tersedia (cabang dari langkah 2)&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;8. Sistem menampilkan pesan peralatan tidak tersedia dan pengajuan tidak dilanjutkan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;9. Isian pengajuan tidak lengkap (cabang dari langkah 4)&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;10. Sistem menampilkan pesan isian belum lengkap dan meminta peminjam melengkapi isian&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;11. Peminjam memilih cetak bukti, dengan condition [mahasiswa memilih cetak] dan extension point Bukti pengajuan tersedia (extend LAB-UC05 Cetak Bukti Pengajuan; lihat Tabel skenario LAB-UC05)&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;12. Sistem menampilkan bukti pengajuan dengan nomor pengajuan sesuai Tabel skenario LAB-UC05&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; font-weight: bold; vertical-align: top;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border: 1px solid #000000; padding: 6px 10px; vertical-align: top;&quot;&gt;Use case selesai jika pengajuan tersimpan dengan status Menunggu Keputusan; jika peralatan tidak tersedia atau isian tidak lengkap, pengajuan tidak tersimpan dan peminjam kembali ke daftar peralatan atau melengkapi isian.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="680" width="750" x="260" y="500" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
